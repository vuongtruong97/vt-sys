    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "1.4.6",
    "jsonwebtoken": "9.0.2",
    "livekit-server-sdk": "~2.7.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.10",
    "prisma": "~5.20.0",
    "typescript": "~5.6.2"
  }
