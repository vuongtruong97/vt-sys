# Sao chép thành .env rồi đổi các giá trị bí mật trước khi chạy thật.

POSTGRES_PASSWORD=bangden_dev_pw

# Chuỗi ngẫu nhiên dài, ví dụ tạo bằng: openssl rand -hex 32
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-1
WHITEBOARD_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-2

# Tên khoá phải trùng webhook.api_key trong livekit.yaml. Secret cần ít nhất 32 ký tự.
LIVEKIT_API_KEY=bangden
LIVEKIT_API_SECRET=doi-secret-livekit-nay-dai-it-nhat-32-ky-tu

# Địa chỉ trình duyệt dùng để kết nối. Trên VPS: wss://live.ten-mien-cua-ban.vn
LIVEKIT_PUBLIC_URL=ws://localhost:7880
WHITEBOARD_PUBLIC_URL=ws://localhost:1234

# Tài khoản giáo viên tạo lần đầu khởi động
SEED_TEACHER_EMAIL=giaovien@bangden.local
SEED_TEACHER_PASSWORD=doimatkhau123
SEED_TEACHER_NAME=Thầy Minh
# true: thêm khoá học mẫu, 5 học viên và một buổi học sắp bắt đầu
SEED_DEMO=true

# true khi chạy sau HTTPS
COOKIE_SECURE=false

# ----- Ghi hình và phát trực tiếp -----
# Mặc định tắt: dịch vụ egress cần ~1,5–2 GB RAM và 2–4 nhân CPU mỗi bản ghi 720p.
# Bật: đặt true VÀ chạy compose với --profile recording (cần thêm S3_* bên dưới).
RECORDING_ENABLED=false

# ----- Lưu trữ cho bản ghi hình và tài liệu -----
# Chạy trên máy: dịch vụ s3 (RustFS) trong docker-compose.yml dùng đúng các giá trị này.
# Trên VPS: điền thông tin Cloudflare R2 hoặc S3 (xem docs/03-trien-khai-vps.md).
S3_BUCKET=bangden
S3_ACCESS_KEY=bangden-s3
S3_SECRET_KEY=doi-secret-s3-nay-di
# Chỉ dùng trên VPS (máy dùng sẵn http://s3:9000)
S3_ENDPOINT=
S3_REGION=auto

# ----- Nhắc lịch qua email (Resend) -----
# Bỏ trống thì API chỉ ghi log nhắc lịch, không gửi email thật.
RESEND_API_KEY=
EMAIL_FROM=Bảng Đen <noreply@ten-mien-cua-ban.vn>

# ----- Đăng nhập bằng Google (tuỳ chọn) -----
# Tạo OAuth client loại "Web application" trong Google Cloud Console, thêm URI chuyển hướng
# <APP_URL>/api/auth/google/callback (trên máy: http://localhost:3000/api/auth/google/callback).
# Bỏ trống thì trang đăng nhập không hiện nút Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Chỉ dùng khi triển khai lên VPS (deploy/docker-compose.prod.yml) -----
# Tên miền chính; cần thêm bản ghi DNS cho live.<DOMAIN> và board.<DOMAIN>
DOMAIN=example.vn
# Email nhận thông báo chứng chỉ Let's Encrypt
ACME_EMAIL=ban@example.vn

# ----- Chỉ dùng cho máy chủ tại nhà (deploy/docker-compose.homelab.yml) -----
# Mạng Docker của Nginx Proxy Manager (xem docs/05-trien-khai-homelab.md, bước 4)
NPM_NETWORK=proxy
# Token Cloudflare (mẫu "Edit zone DNS") cho dịch vụ ddns tự cập nhật IP nhà
CLOUDFLARE_API_TOKEN=
