generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// Chủ trang: dạy được như giáo viên, cấp quyền giáo viên, xem toàn hệ thống.
  ADMIN
  TEACHER
  STUDENT
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum JoinStatus {
  PENDING
  APPROVED
  DENIED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  /// null: tài khoản tạo bằng Google, chưa đặt mật khẩu.
  passwordHash   String?
  /// `sub` của Google khi đã liên kết đăng nhập Google.
  googleId       String?        @unique
  role           Role           @default(STUDENT)
  /// Tăng lên để vô hiệu mọi phiên đăng nhập cũ (đổi mật khẩu, đăng xuất mọi nơi).
  tokenVersion   Int            @default(0)
  createdAt      DateTime       @default(now())
  courses        Course[]       @relation("TeacherCourses")
  enrollments    Enrollment[]
  attendance     Attendance[]
  joinRequests   JoinRequest[]
  chatMessages   ChatMessage[]
  quizAnswers    QuizAnswer[]
  reminders      Reminder[]
  hostedMeetings ClassSession[] @relation("HostedMeetings")
  ggbDocuments   GgbDocument[]

  @@map("users")
}

model Course {
  id          String         @id @default(cuid())
  teacherId   String
  teacher     User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  title       String
  description String         @default("")
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  sessions    ClassSession[]
  enrollments Enrollment[]
  materials   Material[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model ClassSession {
  id                String          @id @default(cuid())
  /// null: meeting độc lập (không thuộc khoá học), chủ phòng là hostId.
  courseId          String?
  course            Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Chủ meeting; buổi học thì null (chủ phòng là giáo viên của khoá học).
  hostId            String?
  host              User?           @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  title             String
  startsAt          DateTime
  endsAt            DateTime
  roomName          String          @unique
  status            SessionStatus   @default(SCHEDULED)
  allowStudentShare Boolean         @default(false)
  /// Đang chia nhóm: học viên có trong breakout_groups vào phòng nhóm thay vì phòng chính.
  breakoutActive    Boolean         @default(false)
  /// Giờ giáo viên hẹn gọi các nhóm về (chỉ để hiện đồng hồ, không tự đóng).
  breakoutEndsAt    DateTime?
  createdAt         DateTime        @default(now())
  breakoutGroups    BreakoutGroup[]
  liveStream        LiveStream?
  attendance        Attendance[]
  joinRequests      JoinRequest[]
  whiteboard        Whiteboard?
  chatMessages      ChatMessage[]
  quizzes           Quiz[]
  recordings        Recording[]
  materials         Material[]
  reminders         Reminder[]
  ggbDocuments      GgbDocument[]
  ggbBoard          GgbBoard?

  @@index([startsAt])
  @@index([hostId, startsAt])
  @@map("sessions")
}

/// Một dòng cho mỗi lần vào phòng, ghi từ webhook LiveKit.
model Attendance {
  id        String       @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime
  leftAt    DateTime?
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@map("attendance")
}

/// Người chưa có trong danh sách lớp xin vào phòng.
model JoinRequest {
  id        String       @id @default(cuid())
  sessionId String
  userId    String
  status    JoinStatus   @default(PENDING)
  createdAt DateTime     @default(now())
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("join_requests")
}

/// Trạng thái Yjs của bảng trắng; máy chủ bảng trắng đọc/ghi bảng này bằng SQL.
model Whiteboard {
  sessionId String       @id @map("session_id")
  state     Bytes
  updatedAt DateTime     @updatedAt @map("updated_at")
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("whiteboards")
}

/// Tin nhắn trong phòng học. API lưu rồi phát xuống phòng qua LiveKit (chủ đề "chat").
model ChatMessage {
  id        String       @id @default(cuid())
  sessionId String
  userId    String
  text      String
  createdAt DateTime     @default(now())
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

/// Câu hỏi trắc nghiệm nhanh giáo viên đưa ra trong buổi học.
model Quiz {
  id        String       @id @default(cuid())
  sessionId String
  question  String
  options   String[]
  /// Vị trí đáp án đúng trong options; null nếu là câu thăm dò ý kiến.
  correct   Int?
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers   QuizAnswer[]

  @@index([sessionId, createdAt])
  @@map("quizzes")
}

model QuizAnswer {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  choice    Int
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId])
  @@map("quiz_answers")
}

/// Phát trực tiếp (webinar): Egress ghép phòng thành HLS trên S3, người xem không vào LiveKit.
model LiveStream {
  id        String          @id @default(cuid())
  sessionId String          @unique
  egressId  String          @unique
  status    RecordingStatus @default(STARTING)
  /// true: ai có link cũng xem được; false: chỉ giáo viên và học viên của khoá.
  public    Boolean         @default(false)
  /// Thư mục trên bucket, ví dụ live/<sessionId>/<thời điểm>
  prefix    String
  error     String?
  startedAt DateTime        @default(now())
  endedAt   DateTime?
  session   ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("live_streams")
}

/// Nhóm nhỏ trong buổi học. Phòng LiveKit của nhóm là `<roomName>-g<index>`.
model BreakoutGroup {
  id        String       @id @default(cuid())
  sessionId String
  index     Int
  name      String
  /// users.id của học viên trong nhóm.
  members   String[]
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, index])
  @@map("breakout_groups")
}

enum RecordingStatus {
  STARTING
  RECORDING
  PROCESSING
  READY
  FAILED
}

/// Bản ghi hình một buổi học (LiveKit Egress, file MP4 trên S3/R2).
model Recording {
  id          String          @id @default(cuid())
  sessionId   String
  egressId    String          @unique
  status      RecordingStatus @default(STARTING)
  /// Đường dẫn file trong bucket.
  key         String
  durationSec Int?
  sizeBytes   BigInt?
  error       String?
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  session     ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("recordings")
}

/// Tài liệu giáo viên tải lên cho khoá học, có thể gắn với một buổi cụ thể.
model Material {
  id          String        @id @default(cuid())
  courseId    String
  sessionId   String?
  name        String
  key         String        @unique
  contentType String
  sizeBytes   Int
  createdAt   DateTime      @default(now())
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session     ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([sessionId])
  @@map("materials")
}

/// Nhắc lịch đã gửi; khoá theo giờ bắt đầu nên đổi giờ buổi học thì nhắc lại.
model Reminder {
  id        String       @id @default(cuid())
  sessionId String
  userId    String
  /// "60": trước khoảng một giờ, "10": sắp vào lớp.
  kind      String
  startsAt  DateTime
  sentAt    DateTime     @default(now())
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, kind, startsAt])
  @@map("reminders")
}

/// Bài GeoGebra (getBase64() của applet). Ảnh thu nhỏ nằm trên S3 nếu có cấu hình lưu trữ.
model GgbDocument {
  id           String        @id @default(cuid())
  title        String
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Bài lưu từ bảng GeoGebra của một buổi học/meeting.
  sessionId    String?
  session      ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  appName      String        @default("classic")
  base64       String        @default("") @db.Text
  thumbnailKey String?
  /// Tăng mỗi lần lưu; lưu bằng version cũ thì bị từ chối (409) để không ghi đè bản mới hơn.
  version      Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ownerId, updatedAt])
  @@map("ggb_documents")
}

/// Bảng GeoGebra của buổi học: trạng thái Yjs do máy chủ bảng trắng (Hocuspocus, document "ggb:<id>") ghi.
/// Tách khỏi bảng whiteboards vì khoá chính của bảng đó là session_id (một bảng phấn mỗi buổi).
model GgbBoard {
  sessionId String       @id @map("session_id")
  state     Bytes
  updatedAt DateTime     @updatedAt @map("updated_at")
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ggb_boards")
}
